import { test, expect } from '@playwright/test';
import { getLocator as getLoginLocator } from '../locators/login-page.locators.js';
import { getLocator as getNavLocator } from '../locators/sidebar-nav.locators.js';
import { getLocator as getFilterLocator } from '../locators/properties-market-filters.locators.js';
import { getLocator as getFeaturesLocator } from '../locators/market-features-filters.locators.js';
import { getLocator as getYFactorLocator } from '../locators/yfactor-filters.locators.js';
import { readExcelData } from '../test-data/read-excel-data.js';

const EMAIL = 'zaid.m@simformsolutions.com';
const PASSWORD = 'Test@123';

const wait = (ms) => new Promise(r => setTimeout(r, ms));

// Read Excel data once before all tests
let marketFeatureValues;
test.beforeAll(async () => {
  const data = await readExcelData();
  // Use first feature from Excel, fallback to default
  const features = data.marketFeatures;
  marketFeatureValues = features.length > 0
    ? { featureType: features[0].featureType, featureName: features[0].features[0] || features[0].featureType, operator: features[0].operator }
    : { featureType: 'Accessibility Features', featureName: 'Accessibility Features', operator: 'AND' };
});

/**
 * Shared: Login → Properties → Open Filters → Fill required → Next to Market Features
 */
async function loginAndNavigateToMarketFeatures(page) {
  // Login
  await page.goto('/login');
  await getLoginLocator(page, 'emailInput').fill(EMAIL);
  await getLoginLocator(page, 'passwordInput').fill(PASSWORD);
  await getLoginLocator(page, 'signInButton').click();
  await page.waitForURL('**/affiliate-managers', { timeout: 15000 });

  // Navigate to Properties
  await getNavLocator(page, 'propertiesNav').click();
  await page.waitForURL('**/properties', { timeout: 15000 });
  await wait(3000);

  // Remove overlay scrim and open Market Filters dialog
  await page.evaluate(() => {
    document.querySelectorAll('.v-overlay__scrim').forEach(el => el.remove());
  });
  await page.getByText('Filter By').click({ force: true });
  await wait(3000);
  await page.locator('.v-dialog').first().waitFor({ state: 'visible', timeout: 10000 });

  // Fill required fields: MLS Board, State, County
  await page.locator('.v-dialog input[placeholder="Select MLS Board"]').click({ force: true });
  await wait(2000);
  await page.locator('.v-overlay--active .v-list-item').first().click();
  await wait(3000);

  await page.locator('.v-dialog input[placeholder="Select State"]').click({ force: true });
  await wait(2000);
  await page.locator('.v-overlay--active .v-list-item').first().click();
  await wait(3000);

  await page.locator('.v-dialog input[placeholder="Select County"]').click({ force: true });
  await wait(2000);
  await page.locator('.v-overlay--active .v-list-item').first().click();
  await wait(2000);

  // Click Next to reach Market Features Filters
  await getFilterLocator(page, 'nextButton').click();
  await wait(3000);
}

test.describe('CREX Agent - Market Features & Y-Factor Flow', () => {

  test('should add a market feature and navigate to Y-Factor Filters', async ({ page }) => {
    await loginAndNavigateToMarketFeatures(page);

    // ===== Verify Market Features Filters page loaded =====
    await expect(getFeaturesLocator(page, 'marketFeaturesDialogTitle')).toBeVisible();
    await expect(getFeaturesLocator(page, 'marketFeaturesHeading')).toBeVisible();

    // ===== Click "Add New Market Feature" =====
    await page.getByRole('button', { name: 'Add New Market Feature' }).click();
    await wait(3000);

    // ===== Verify the Add New Market Feature dialog opened =====
    await expect(page.getByText('Add new market feature for applying them as a filter.')).toBeVisible();

    // ===== Select Feature Type (first dropdown in nested dialog) =====
    const nestedDialog = page.locator('.v-overlay--active:has(h3:has-text("Add New Market Feature"))');
    const featureTypeSelect = nestedDialog.locator('.v-select').first();
    await featureTypeSelect.click({ force: true });
    await wait(2000);

    // Verify Feature Type dropdown has options
    const featureTypeItems = page.locator('.v-overlay--active').last().locator('.v-list-item');
    await expect(featureTypeItems.first()).toBeVisible();

    // Select first Feature Type (Accessibility Features)
    await featureTypeItems.first().click();
    await wait(3000);

    // ===== Select Features (second dropdown, now enabled) =====
    const featuresSelect = nestedDialog.locator('.v-select').nth(1);
    await featuresSelect.click({ force: true });
    await wait(2000);

    // Verify Features dropdown has options
    const featureItems = page.locator('.v-overlay--active').last().locator('.v-list-item');
    await expect(featureItems.first()).toBeVisible();

    // Select first Feature
    await featureItems.first().click();
    await wait(1000);

    // Close the multi-select dropdown
    await page.keyboard.press('Escape');
    await wait(1000);

    // ===== Operator defaults to AND — verify =====
    await expect(page.locator('#operator-AND')).toBeChecked();

    // ===== Click "Add Feature" button =====
    await page.getByRole('button', { name: 'Add Feature', exact: true }).click();
    await wait(3000);

    // ===== Verify feature appears in table =====
    await expect(page.getByText(marketFeatureValues.featureType).first()).toBeVisible();
    await expect(page.getByText('Operator: AND')).toBeVisible();

    // ===== Click Next to go to Y-Factor Filters =====
    await getFeaturesLocator(page, 'nextButton').click();
    await wait(3000);

    // ===== Verify Y-Factor Filters page =====
    await expect(page.getByText('Configure Y-factor filters for your property search')).toBeVisible();

    // Verify Y-Factor table headers
    await expect(getYFactorLocator(page, 'yFactorsHeader')).toBeVisible();
    await expect(getYFactorLocator(page, 'minUnitValueHeader')).toBeVisible();
    await expect(getYFactorLocator(page, 'maxUnitValueHeader')).toBeVisible();

    // Verify Y-Factor rows are present
    await expect(page.getByText('Bedrooms Total')).toBeVisible();
    await expect(page.getByText('Bathrooms Total')).toBeVisible();
    await expect(page.getByText('Site Area', { exact: true })).toBeVisible();
    await expect(page.getByText('Finished Sq Ft', { exact: true })).toBeVisible();
    await expect(page.getByText('Year Built', { exact: true })).toBeVisible();

    // Verify navigation buttons
    await expect(getYFactorLocator(page, 'previousButton')).toBeVisible();
    await expect(getYFactorLocator(page, 'resetAllFiltersButton')).toBeVisible();
    await expect(getYFactorLocator(page, 'applyFiltersButton')).toBeVisible();
  });

});
