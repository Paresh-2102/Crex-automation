import { test, expect } from '@playwright/test';
import { getLocator as getLoginLocator } from '../locators/login-page.locators.js';
import { getLocator as getNavLocator } from '../locators/sidebar-nav.locators.js';
import { getLocator as getFilterLocator } from '../locators/properties-market-filters.locators.js';
import { readExcelData } from '../test-data/read-excel-data.js';

const EMAIL = 'zaid.m@simformsolutions.com';
const PASSWORD = 'Test@123';

const wait = (ms) => new Promise(r => setTimeout(r, ms));

// Read Excel data once before all tests
let filterValues;
test.beforeAll(async () => {
  const data = await readExcelData();
  filterValues = data.marketFilters;
});

/**
 * Helper: select a value from a Vuetify v-autocomplete dropdown.
 * Clicks the input, waits for the dropdown list, picks the first option.
 */
async function selectDropdownFirstOption(page, inputLocator) {
  await inputLocator.click({ force: true });
  await wait(2000);
  const items = page.locator('.v-overlay--active .v-list-item, .v-menu__content .v-list-item');
  await items.first().waitFor({ state: 'visible', timeout: 10000 });
  await items.first().click();
  await wait(2000);
}

/**
 * Shared: Login + Navigate to Properties + Open Filter Dialog
 */
async function loginAndOpenFilters(page) {
  // Login
  await page.goto('/login');
  await getLoginLocator(page, 'emailInput').fill(EMAIL);
  await getLoginLocator(page, 'passwordInput').fill(PASSWORD);
  await getLoginLocator(page, 'signInButton').click();
  await page.waitForURL('**/affiliate-managers', { timeout: 15000 });

  // Navigate to Properties
  await getNavLocator(page, 'propertiesNav').click();
  await page.waitForURL('**/properties', { timeout: 15000 });
  await wait(3000);

  // Remove overlay scrim and open Market Filters dialog
  await page.evaluate(() => {
    document.querySelectorAll('.v-overlay__scrim').forEach(el => el.remove());
  });
  await page.getByText('Filter By').click({ force: true });
  await wait(3000);
  await page.locator('.v-dialog').first().waitFor({ state: 'visible', timeout: 10000 });
}

test.describe('CREX Agent - Market Filters Selection', () => {

  test('should select values in all Market Filters dropdowns', async ({ page }) => {
    await loginAndOpenFilters(page);

    // ===== Select MLS Board =====
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select MLS Board"]'));
    // Verify MLS Board label is still shown
    await expect(getFilterLocator(page, 'mlsBoardLabel')).toBeVisible();
    await wait(2000);

    // ===== Select State (loads after MLS Board) =====
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select State"]'));
    await expect(getFilterLocator(page, 'stateLabel')).toBeVisible();
    await wait(2000);

    // ===== Select County (loads after State) =====
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select County"]'));
    await expect(getFilterLocator(page, 'countyLabel')).toBeVisible();
    await wait(2000);

    // ===== Select City (loads after County) =====
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select Cities"]'));
    await page.keyboard.press('Escape');
    await wait(1500);

    // ===== Select Zip Code =====
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select Zip Codes"]'));
    await page.keyboard.press('Escape');
    await wait(1500);

    // ===== Select Property Status =====
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select property status"]'));
    await page.keyboard.press('Escape');
    await wait(1500);

    // ===== Fill Price Range using filter values =====
    await getFilterLocator(page, 'minPriceInput').fill(filterValues.minPrice);
    await getFilterLocator(page, 'maxPriceInput').fill(filterValues.maxPrice);

    // ===== Verify all fields filled & Next button visible =====
    await expect(getFilterLocator(page, 'nextButton')).toBeVisible();
    await expect(getFilterLocator(page, 'cancelButton')).toBeVisible();
  });

  test('should fill Market Filters and click Next to reach Features page', async ({ page }) => {
    await loginAndOpenFilters(page);

    // ===== Fill all required dropdowns =====
    // MLS Board
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select MLS Board"]'));
    await wait(2000);

    // State
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select State"]'));
    await wait(2000);

    // County
    await selectDropdownFirstOption(page,
      page.locator('.v-dialog input[placeholder="Select County"]'));
    await wait(2000);

    // Fill Price Range
    await getFilterLocator(page, 'minPriceInput').fill(filterValues.minPrice);
    await getFilterLocator(page, 'maxPriceInput').fill(filterValues.maxPrice);

    // ===== Click Next to go to Market Features Filters =====
    await getFilterLocator(page, 'nextButton').click();
    await wait(3000);

    // ===== Verify we are on Market Features Filters page =====
    // The dialog title changes to "Market Features Filters"
    await expect(page.locator('.v-dialog h4:has-text("Market Features Filters")')).toBeVisible();

    // Verify the Market Features section heading (h5 with exact text)
    await expect(page.getByRole('heading', { name: 'Market Features', exact: true })).toBeVisible();
    await expect(page.getByText('Add New Market Feature')).toBeVisible();

    // Verify table headers
    await expect(page.getByText('Feature Type')).toBeVisible();
    await expect(page.getByText('Description')).toBeVisible();
    await expect(page.getByText('Actions', { exact: true })).toBeVisible();

    // Verify empty state message
    await expect(page.getByText('No market features added yet.')).toBeVisible();
    await expect(page.getByText('Add Your First Feature')).toBeVisible();

    // Verify navigation buttons
    await expect(page.getByRole('button', { name: 'Previous' })).toBeVisible();
    await expect(page.getByRole('button', { name: 'Cancel' })).toBeVisible();
    await expect(page.getByRole('button', { name: 'Next' })).toBeVisible();
  });

});

